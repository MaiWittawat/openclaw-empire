# Database Configuration
DB_HOST=psql
DB_PORT=5432
DB_USER=claw_admin
DB_PASS=claw_admin
DB_NAME=claw_admin

# Backend Configuration
SERVER_NAME=CLAW_EMPIRE
SERVER_HOST=0.0.0.0
SERVER_PORT=8212
SERVER_MODE=prod

# OpenClaw Gateway Configuration
OPENCLAW_GATEWAY_WS_URL=ws://host.docker.internal:18789/ws
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_DEFAULT_SESSION_KEY=main
OPENCLAW_DEVICE_STORE_PATH=/app/data/openclaw/device.json
OPENCLAW_CLIENT_ID=openclaw-empire
OPENCLAW_CLIENT_VERSION=1.0.0
OPENCLAW_CLIENT_PLATFORM=linux
OPENCLAW_CLIENT_DEVICE_FAMILY=server
OPENCLAW_RECONNECT_DELAY_MS=3000
OPENCLAW_COMMAND_TIMEOUT_MS=15000
OPENCLAW_ACTIVE_WINDOW_MINUTE=15
